{
  "mcpServers": {
    "dart-sdk": {
      "command": "dart",
      "args": ["mcp-server"],
      "description": "Built-in Dart SDK MCP server (requires Dart 3.9+)"
    },
    "dart-npm": {
      "command": "npx",
      "args": ["-y", "@egyleader/dart-mcp-server"],
      "description": "NPM-based Dart/Flutter MCP server tool"
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=sssrdqyhhqorltejqqeo&features=database%2Cdocs%2Cdebugging%2Cstorage%2Cdevelopment%2Cfunctions"
    }
  }
}
